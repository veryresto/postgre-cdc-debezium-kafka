# Deployment Configuration Template
# Copy this file to .env and adjust the values

# The IP address or hostname of the VM running the services.
# When running in a single VM, you can use the VM's private IP (e.g., 172.16.13.158)
# to ensure services can communicate via the host network when necessary.

# AI-MASTER-DB (Postgres)
MASTER_DB_HOST=127.0.0.1

# AI-LANDING-DB (Kafka & Debezium Connect)
LANDING_DB_HOST=127.0.0.1

# AI-ETL (Spark, MinIO, Trino)
ETL_HOST=127.0.0.1
